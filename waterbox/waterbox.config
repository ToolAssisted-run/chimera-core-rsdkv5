{
  "coreName": "rsdkv5",
  "systemNames": {
    "SonicMania": "Sonic Mania"
  },
  "systemId": "SonicMania",
  "_system_note": "The Retro Engine v5 decompilation with the Sonic Mania decompilation's logic compiled in: the game is Sonic Mania, whose data file the project brings as firmware.",
  "kind": "game",
  "author": "Evening Star (Retro Engine v5); the RSDKv5 decompilation by Rubberduckycooly and chuliRMG; the Sonic Mania decompilation (RSDKModding); chimera port by Sergio Martin",
  "url": "https://github.com/ToolAssisted-run/chimera-core-rsdkv5",
  "deterministic": true,
  "_memory_note": "[sbrk, sealed, invisible, plain, mmap] MiB: the engine's own memory (its storage pools for scenes, sprites, sound and the objects) on the heap; the game's data file in sealed memory, read-only after Init and so in no savestate (the checked one is 199 MiB); SDL's and C++'s larger allocations mmap'd. A savestate of Sonic Mania in play is 40 MB.",
  "memoryLayoutMiB": [
    256,
    1024,
    4,
    4,
    512
  ],
  "video": {
    "_comment": "What the engine's SDL device draws into its window, with SDL's software renderer: the game's screen (240 lines, as wide as the Screen Width setting, 424 by default), its videos scaled into it, and in the competition mode the two players' screens one above the other.",
    "width": 424,
    "height": 240,
    "virtualWidth": 424,
    "virtualHeight": 240,
    "vsyncNumerator": 60,
    "vsyncDenominator": 1,
    "getBgra": "GetVideoBgra"
  },
  "audio": {
    "_comment": "The engine's own mixer (its music, its sound effects and the videos' sound), run for exactly one sixtieth of a second each frame: 735 stereo samples at 44100 Hz.",
    "rate": 44100,
    "samplesPerFrame": 735,
    "channels": 2,
    "get": "GetAudio"
  },
  "lag": {
    "inputWasRead": "InputWasRead"
  },
  "input": {
    "name": "Sonic Mania",
    "_comment": "Two players' pads, each the engine's twelve inputs: the directions, A, B, C, X, Y, Z, Start and Select. Sonic Mania jumps with A, B or C, goes back in its menus with B, and pauses with Start; the second pad plays Tails or the competition mode's second player. The engine keeps them as a keyboard's state, one bit a button.",
    "buttons": [
      "P1 Up",
      "P1 Down",
      "P1 Left",
      "P1 Right",
      "P1 A",
      "P1 B",
      "P1 C",
      "P1 X",
      "P1 Y",
      "P1 Z",
      "P1 Start",
      "P1 Select",
      "P2 Up",
      "P2 Down",
      "P2 Left",
      "P2 Right",
      "P2 A",
      "P2 B",
      "P2 C",
      "P2 X",
      "P2 Y",
      "P2 Z",
      "P2 Start",
      "P2 Select"
    ],
    "mnemonics": {
      "Up": "U",
      "Down": "D",
      "Left": "L",
      "Right": "R",
      "A": "A",
      "B": "B",
      "C": "C",
      "X": "X",
      "Y": "Y",
      "Z": "Z",
      "Start": "S",
      "Select": "s"
    }
  },
  "settings": [
    {
      "name": "language",
      "display": "Language",
      "type": "enum",
      "options": [
        "en",
        "fr",
        "it",
        "de",
        "es",
        "ja",
        "ko",
        "zhs",
        "zh"
      ],
      "default": "en",
      "description": "The language of the game's texts (the engine's language setting): English, French, Italian, German, Spanish, Japanese, Korean, Chinese (simplified) or Chinese (traditional). The game reads it, so a movie records it.",
      "optionLabels": {
        "en": "English",
        "fr": "French",
        "it": "Italian",
        "de": "German",
        "es": "Spanish",
        "ja": "Japanese",
        "ko": "Korean",
        "zhs": "Chinese (simplified)",
        "zh": "Chinese (traditional)"
      }
    },
    {
      "name": "region",
      "display": "Region",
      "type": "enum",
      "options": [
        "data",
        "us",
        "jp",
        "eu"
      ],
      "default": "data",
      "description": "The region the game believes it is in (the engine's region setting). \"data\" leaves it to the game's data, as upstream does by default. The game reads it (the logos it shows, for one), so a movie records it.",
      "optionLabels": {
        "data": "The data's own",
        "us": "USA",
        "jp": "Japan",
        "eu": "Europe"
      }
    },
    {
      "name": "screenWidth",
      "display": "Screen Width",
      "type": "int",
      "default": 424,
      "min": 320,
      "max": 424,
      "description": "How many pixels wide the screen is (the engine's pixWidth setting). 424 is upstream's default, a 16:9 screen; 320 a 4:3 one. The width changes how far ahead the player sees and which objects are awake, so it changes the game, and a movie records it."
    },
    {
      "name": "plus",
      "display": "Plus Content",
      "type": "bool",
      "default": false,
      "description": "Turns on the Sonic Mania Plus content in the data file (the Plus title, Encore mode, Mighty and Ray), as owning the Plus release does. Off by default, as the decompilation's licence requires of a build given out; with it off the game is Sonic Mania without Plus. The data file must hold the Plus content (the Plus release's does). It changes the game, so a movie records it."
    },
    {
      "name": "randomSeed",
      "display": "Random Seed",
      "type": "int",
      "default": 0,
      "min": 0,
      "max": 2147483647,
      "description": "The number the engine's random numbers start from. The engine takes it from the clock when it starts (time()); here it is this number, so a movie plays the same every time. The dates the game writes into its records are this number too. A movie records it."
    }
  ],
  "firmware": [
    {
      "id": "Data.rsdk",
      "display": "Sonic Mania data file (Data.rsdk)",
      "description": "The data file of Sonic Mania: everything the game is but its program. The copy that was checked is 199 MiB, a Data.rsdk as the Plus release has it. Steam's and the consoles' Data.rsdk are the same kind of file; the Plus content in it stays off, as the decompilation's licence requires. You have to supply it, because this package includes none of the game's files. A file of your own can be used in its place, and the project then records its hash.",
      "sha1": "ED5C790106A670E6FDF04CCD876D560B1B08C895",
      "name": "Data.rsdk"
    }
  ]
}
